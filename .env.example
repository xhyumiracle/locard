# BlockchainMAS Environment Variables
# Copy this file to .env and fill in your API keys

# ==================== BTC/DOGE APIs ====================
BLOCKCYPHER_TOKEN=                # Optional, 无需 API key 即可测试
BLOCKCHAIR_API_KEY=               # Optional, 无需 key 有免费额度 (1440次/天)
BITQUERY_API_KEY=                 # Optional

# ==================== ETH APIs ====================
ETHERSCAN_API_KEY=                # Required
ALCHEMY_API_KEY=                  # Required
INFURA_PROJECT_ID=                # Required

# ==================== Price/Exchange Rate APIs ====================
# Binance API: 无需配置，完全免费
CRYPTOCOMPARE_API_KEY=            # Optional（备用方案）

# ==================== LLM Config ====================
LLM_MODEL=gpt-4o                  # or gpt-4, gpt-3.5-turbo, etc.
OPENAI_API_KEY=                   # Required if using OpenAI models

# ==================== Logging ====================
LOG_LEVEL=INFO                    # DEBUG, INFO, WARNING, ERROR
DEBUG_MODE=false                  # true for development
