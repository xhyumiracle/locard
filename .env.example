# Environment Variables
# Copy this file to .env and fill in your API keys

# ==================== Blockchain Data APIs ====================
# Optional, 无需 key 有免费额度 (1440次/天)
BLOCKCHAIR_API_KEY=

# Alchemy API (ETH) - Free tier: 3M compute units/month
# Get your API key from: https://dashboard.alchemy.com/
ALCHEMY_API_KEY=

# Bitquery API (Multi-chain GraphQL) - Paid plans from $249/month
# Free tier: 10k points (one-time), 10 rows/request, 10 req/min
# Get your API key from: https://bitquery.io/
BITQUERY_API_KEY=

# ==================== LLM Config ====================
# Provider auto-detected from model name:
# - "gpt-*" → OpenAI (gpt-4o, gpt-4o-mini, gpt-3.5-turbo)
# - "claude-*" → Anthropic (claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
# Default model for all agents
LLM_MODEL=gpt-4o
# Lite model for simple tasks
LLM_MODEL_LITE=gpt-4o-mini
# Required if using OpenAI models (gpt-*)
OPENAI_API_KEY=
# Required if using Anthropic models (claude-*)
ANTHROPIC_API_KEY=

# Per-agent model overrides (optional)
# If not set, agents will use LLM_MODEL (or LLM_MODEL_LITE for router/report)
# Trace orchestrator model
AGENT_MODEL_ORCHESTRATOR=
# Trace fetcher model
AGENT_MODEL_FETCHER=
# Router model (defaults to LLM_MODEL_LITE)
AGENT_MODEL_ROUTER=
# Report model (defaults to LLM_MODEL_LITE)
AGENT_MODEL_REPORT=
# ==================== Logging ====================
# VERBOSE_LEVEL controls logging detail across the application
# 0 = WARNING only (default)
# 1 = INFO (basic workflow)
# 2 = DEBUG (business code) + INFO (third-party libraries) + traceback on errors
# 3 = DEBUG (everything including third-party)
# Can be overridden by -v/-vv/-vvv command line flags
VERBOSE_LEVEL=0
