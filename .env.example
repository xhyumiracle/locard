# BlockchainMAS Environment Variables
# Copy this file to .env and fill in your API keys

# ==================== BTC/DOGE APIs ====================
BLOCKCYPHER_TOKEN=                # Optional, 无需 API key 即可测试
BLOCKCHAIR_API_KEY=               # Optional, 无需 key 有免费额度 (1440次/天)
BITQUERY_API_KEY=                 # Optional

# ==================== ETH APIs ====================
ETHERSCAN_API_KEY=                # Required
ALCHEMY_API_KEY=                  # Required
INFURA_PROJECT_ID=                # Required

# ==================== Price/Exchange Rate APIs ====================
# Binance API: 无需配置，完全免费
CRYPTOCOMPARE_API_KEY=            # Optional（备用方案）

# ==================== LLM Config ====================
LLM_MODEL=gpt-4o                  # Default model for all agents
LLM_MODEL_LITE=gpt-4o-mini        # Lite model for simple tasks
OPENAI_API_KEY=                   # Required if using OpenAI models

# Per-agent model overrides (optional)
# If not set, agents will use LLM_MODEL (or LLM_MODEL_LITE for router/report)
AGENT_MODEL_ORCHESTRATOR=         # Trace orchestrator model
AGENT_MODEL_FETCHER=              # Trace fetcher model
AGENT_MODEL_ROUTER=               # Router model (defaults to LLM_MODEL_LITE)
AGENT_MODEL_REPORT=               # Report model (defaults to LLM_MODEL_LITE)

# ==================== Logging ====================
# VERBOSE_LEVEL controls logging detail across the application
# 0 = WARNING only (default)
# 1 = INFO (basic workflow)
# 2 = DEBUG (business code) + INFO (third-party libraries)
# 3 = DEBUG (everything including third-party)
# Can be overridden by -v/-vv/-vvv command line flags
VERBOSE_LEVEL=0

# Enable detailed error traces in development
DEBUG_MODE=false
